# Machine-specific settings. Copy to local.env (not committed), fill in the paths, then:
#   source local.env
# prior-pose-refine reads PYTHON and finds colmap on PATH; the other variables are used in the docs.

# Directory holding a CUDA build of COLMAP 4.x (or a wrapper that sets LD_LIBRARY_PATH for it)
export PATH=/path/to/colmap/bin:$PATH
# Python with numpy and scipy (pycolmap as well, for analysis scripts and tests)
export PYTHON=/path/to/python
# LichtFeld Studio binary, for training
export LICHTFELD=/path/to/LichtFeld-Studio
# Scans exported by the capture app; outputs conventionally go next to them as <scan>_opt
export SCAN_ROOT=/path/to/scans
# Experiments, their scripts and pre-change backups, outside the repository
export EXP_ROOT=/path/to/experiments
